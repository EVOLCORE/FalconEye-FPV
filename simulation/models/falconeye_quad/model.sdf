<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="falconeye_quad">
    <pose>0 0 0.1 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <!-- Base Airframe Link (Carbon Fiber 7-inch FPV frame) -->
    <link name="base_link">
      <inertial>
        <mass>0.95</mass> <!-- Frame + Battery + Companion Computer -->
        <inertia>
          <ixx>0.0055</ixx>
          <iyy>0.0055</iyy>
          <izz>0.0098</izz>
        </inertia>
      </inertial>
      
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.28 0.28 0.08</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.28 0.28 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
          <specular>0.8 0.8 0.8 1.0</specular>
        </material>
      </visual>

      <!-- Forward-Facing AI Camera Sensor (30-degree tilt for forward flight) -->
      <sensor name="camera_front" type="camera">
        <pose>0.12 0 0.02 0 0.26 0</pose> <!-- 15-deg uptilt (0.26 rad) standard for FPV -->
        <always_on>1</always_on>
        <update_rate>60</update_rate>
        <camera>
          <horizontal_fov>1.745</horizontal_fov> <!-- 100 deg horizontal FOV -->
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>1000.0</far>
          </clip>
        </camera>
        <topic>/falconeye/camera/image_raw</topic>
      </sensor>

      <!-- Onboard IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>500</update_rate>
        <topic>/falconeye/imu</topic>
      </sensor>
    </link>

  </model>
</sdf>
