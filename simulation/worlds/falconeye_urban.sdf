<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="falconeye_urban">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Sunlight & Atmosphere -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane (Asphalt Test Field) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target Vehicle (Moving Ground Target) -->
    <model name="target_vehicle_car">
      <pose>15 0 0.5 0 0 0</pose>
      <link name="chassis">
        <inertial>
          <mass>1200.0</mass>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>4.2 1.8 1.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>4.2 1.8 1.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient> <!-- Red Vehicle for easy visual identification -->
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
